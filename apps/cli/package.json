{
  "name": "@weaver/cli",
  "version": "0.0.0-dev",
  "description": "The owner's commands: plug Weaver into a project, check that it is alive there, and decide on the cards agents left",
  "private": true,
  "type": "module",
  "bin": {
    "weaver": "./dist/bin/weaver.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/weaver.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@weaver/agent-sdk": "workspace:*",
    "@weaver/engine": "workspace:*",
    "@weaver/memory": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
