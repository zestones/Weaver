{
  "$schema": "https://knip.dev/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{js,mjs,ts}"]
    },
    "packages/engine": {
      "entry": ["src/index.ts", "src/bin/hook.ts", "src/bin/review-worker.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/agent-sdk": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/bin/weaver.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
